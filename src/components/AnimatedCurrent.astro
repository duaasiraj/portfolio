---

import { currentlyItems } from '../data/currently';

interface Props {
  items?: string[];
  /** milliseconds each item stays on screen */
  intervalMs?: number;
}
const { items = currentlyItems, intervalMs = 2800 } = Astro.props;
---

<div class="current" role="status" aria-live="polite" data-interval={intervalMs}>
  <span class="current__label technical-sm">CURRENTLY</span>
  <div class="current__track">
    {items.map((item, i) => (
      <span class:list={['current__item', 'label-md', { 'is-active': i === 0 }]} data-current-item>
        <span class="current__arrow" aria-hidden="true">→</span> {item}
      </span>
    ))}
  </div>
</div>

<style>
  .current {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .current__label {
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
    flex: none;
  }

  .current__track {
    position: relative;
    height: 1.4em;
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }

  .current__item {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
    color: var(--color-on-background);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 400ms ease, transform 400ms ease;
  }

  .current__item.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .current__item.is-leaving {
    opacity: 0;
    transform: translateY(-10px);
  }

  .current__arrow {
    color: var(--color-signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .current__item {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.current').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-current-item]'));
    if (items.length < 2) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const intervalMs = Number(root.dataset.interval) || 2800;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function step() {
      const current = items[index];
      const nextIndex = (index + 1) % items.length;
      const next = items[nextIndex];

      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      next.classList.add('is-active');

      setTimeout(() => current.classList.remove('is-leaving'), 400);
      index = nextIndex;
    }

    function start() {
      if (!timer) timer = setInterval(step, intervalMs);
    }
    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    start();
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
  });
</script>