---
import TechBadge from './TechBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
  isLast?: boolean;
}
const { entry, isLast = false } = Astro.props;
const { role, org, location, dateRange, stack } = entry.data;
const { Content } = await entry.render();
---

<article class:list={['timeline-item', { 'timeline-item--last': isLast }]}>
  <div class="timeline-item__rail" aria-hidden="true">
    <span class="dot signal"></span>
    {!isLast && <span class="timeline-item__line"></span>}
  </div>

  <div class="timeline-item__body">
    <div class="timeline-item__head">
      <div>
        <h3 class="headline-md timeline-item__role">{role}</h3>
        <p class="label-md timeline-item__org">
          {org}{location && <span class="timeline-item__location"> · {location}</span>}
        </p>
      </div>
      <span class="technical-sm timeline-item__date">{dateRange}</span>
    </div>

    <div class="timeline-item__content body-md">
      <Content />
    </div>

    {stack.length > 0 && (
      <div class="timeline-item__stack">
        {stack.map((s: string) => <TechBadge label={s} />)}
      </div>
    )}
  </div>
</article>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 24px;
  }

  .timeline-item__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline-item__rail .dot {
    margin-top: 6px;
  }

  .timeline-item__line {
    flex: 1;
    width: var(--hairline);
    background: var(--color-outline-variant);
    margin-top: 8px;
  }

  .timeline-item__body {
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .timeline-item--last .timeline-item__body {
    padding-bottom: 0;
  }

  .timeline-item__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .timeline-item__org {
    color: var(--color-on-surface-variant);
    margin-top: 4px;
  }

  .timeline-item__location {
    color: var(--color-on-surface-variant);
  }

  .timeline-item__date {
    color: var(--color-signal);
    text-transform: uppercase;
    white-space: nowrap;
    padding-top: 4px;
  }

  .timeline-item__content :global(ul) {
    color: var(--color-on-surface-variant);
    padding-left: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .timeline-item__content :global(p) {
    color: var(--color-on-surface-variant);
    margin: 0 0 8px;
  }

  .timeline-item__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>