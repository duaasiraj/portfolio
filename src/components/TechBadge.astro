---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<span class="tech-badge technical-sm">{label}</span>

<style>
  .tech-badge {
    display: inline-flex;
    padding: 4px 8px;
    border: var(--hairline) solid var(--color-outline-variant);
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>