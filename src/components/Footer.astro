---
import { site } from '../data/site';
import { socialLinks } from '../data/socials';
---

<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__about">
      <span class="label-caps">ABOUT ME</span>
      <span class="technical-sm">{site.name} · {site.title}</span>
    </div>
    <div class="footer__links">
      <a href={`${import.meta.env.BASE_URL}about/`} class="footer__link technical-sm">MORE ABOUT ME →</a>
      <nav class="footer__socials" aria-label="Social links">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" class="footer__social technical-sm">
            {social.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: var(--hairline) solid var(--color-outline-variant);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .footer__about {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer__about .label-caps {
    color: var(--color-signal);
  }

  .footer__about .technical-sm,
  .footer__link,
  .footer__social {
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
  }

  .footer__links,
  .footer__socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer__links {
    justify-content: flex-end;
    gap: 24px;
  }

  .footer__socials {
    gap: 16px;
  }

  .footer__link:hover,
  .footer__social:hover {
    color: var(--color-on-background);
  }

  @media (max-width: 640px) {
    .footer__inner,
    .footer__links { align-items: flex-start; flex-direction: column; }
    .footer__links { gap: 12px; }
  }
</style>
