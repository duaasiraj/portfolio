---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  return logs.map((log) => ({
    params: { slug: log.slug },
    props: { log },
  }));
}

interface Props {
  log: CollectionEntry<'logs'>;
}

const { log } = Astro.props;
const { Content } = await log.render();
const base = import.meta.env.BASE_URL;

const dateStr = log.data.date
  .toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  .toUpperCase();
---

<BaseLayout title={log.data.title} description={log.data.excerpt}>
  <article class="shell entry">
    <a href={`${base}mission-log/`} class="technical-sm back-link">← MISSION LOG</a>

    <header class="entry__head">
      <SectionLabel text={`${log.data.tag} · ${dateStr}`} />
      <h1 class="headline-lg entry__title">{log.data.title}</h1>
    </header>

    <hr class="hr" />

    <div class="entry__content body-md">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 48px;
    padding-bottom: 96px;
    max-width: 720px;
  }

  .back-link {
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
    width: fit-content;
  }

  .back-link:hover {
    color: var(--color-signal);
  }

  .entry__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .entry__content :global(p) {
    color: var(--color-on-surface-variant);
    margin-bottom: 16px;
  }
</style>
