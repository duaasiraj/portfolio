---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';

const focusAreas = [
  {
    label: 'AREA 01',
    title: 'Bioacoustic monitoring',
    body: 'Using audio classification and statistical drift detection to flag early signs of species disappearance from field recordings.',
  },
  {
    label: 'AREA 02',
    title: 'Interpretable ML',
    body: 'Investigating why model confidence scores are poorly calibrated, and what that means for how we should trust predictions in the wild.',
  },
  {
    label: 'AREA 03',
    title: 'Systems for agents',
    body: 'Designing reliable multi-agent systems that reason under ambiguity — negotiation, coordination, and failure recovery.',
  },
];

const timeline = [
  { date: 'MAY 2026 — PRESENT', title: 'ML Research Intern, EcoMuhafiz', body: 'Building the bioacoustic classification pipeline described in "Eco Muhafiz."' },
  { date: '2025', title: 'Independent study, model calibration', body: 'Coursework and independent reading on confidence calibration in deep classifiers.' },
];
---

<BaseLayout title="Research" description="Research interests and current work by Alex Chen.">
  <section class="shell page-head">
    <SectionLabel text="RESEARCH" />
    <h1 class="display-lg page-head__title">Open questions<span class="dot-red">.</span></h1>
    <p class="body-md page-head__lede">
      The things I keep coming back to — where AI meets messy, real-world systems, and where
      it doesn't yet meet them well enough.
    </p>
  </section>

  <section class="shell focus-grid">
    {focusAreas.map((area) => (
      <div class="focus-card card">
        <span class="technical-sm focus-card__label">{area.label}</span>
        <h3 class="headline-md focus-card__title">{area.title}</h3>
        <p class="body-md focus-card__body">{area.body}</p>
      </div>
    ))}
  </section>

  <hr class="hr shell-hr" />

  <section class="shell timeline-section">
    <SectionLabel text="TIMELINE" as="h2" />
    <div class="timeline">
      {timeline.map((t) => (
        <div class="timeline__row">
          <span class="dot signal" aria-hidden="true"></span>
          <div class="timeline__body">
            <span class="technical-sm timeline__date">{t.date}</span>
            <h4 class="label-md timeline__title">{t.title}</h4>
            <p class="body-md timeline__desc">{t.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .dot-red {
    color: var(--color-signal);
  }

  .page-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 80px;
    padding-bottom: 48px;
    max-width: 720px;
  }

  .page-head__lede {
    color: var(--color-on-surface-variant);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-bottom: 64px;
  }

  .focus-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .focus-card__label {
    color: var(--color-signal);
    text-transform: uppercase;
  }

  .focus-card__body {
    color: var(--color-on-surface-variant);
  }

  .shell-hr {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .timeline-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 640px;
  }

  .timeline__row {
    display: flex;
    gap: 16px;
  }

  .timeline__row .dot {
    margin-top: 6px;
  }

  .timeline__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .timeline__date {
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
  }

  .timeline__desc {
    color: var(--color-on-surface-variant);
  }

  @media (max-width: 1024px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
